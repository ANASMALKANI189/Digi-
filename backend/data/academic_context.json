  "assessment_rules": {
    "internal_40_marks": {
      "total_marks": 40,

      "components": {
        "best_of_ise_1_ise_2": {
          "maximum_marks": 20,
          "selection_rule": "higher_of_ise_1_and_ise_2"
        },
        "ise_3": {
          "maximum_marks": 10
        },
        "ie": {
          "maximum_marks": 10
        }
      },

      "formula": "max(ISE_1, ISE_2) + ISE_3 + IE"
    },

    "raw_practical_or_tutorial_conversion": {
      "raw_marks_scale": 100,
      "activity_count": "variable",

      "average": {
        "formula": "sum_of_raw_marks / number_of_activities"
      },

      "official_component_conversion": {
        "formula": "average_raw_marks * official_component_maximum / 100"
      },

      "examples": [
        {
          "average_raw_marks": 90,
          "official_component_maximum": 25,
          "converted_marks": 22.5
        },
        {
          "average_raw_marks": 90,
          "official_component_maximum": 15,
          "converted_marks": 13.5
        },
        {
          "average_raw_marks": 90,
          "official_component_maximum": 10,
          "converted_marks": 9
        }
      ]
    }
  },

